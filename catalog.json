      "agents": ["claude-code", "codex", "opencode", "pi", "kimi-code", "zcode", "gemini", "aider", "qwen-code"],
      "symptoms": [
        "agents fail with connection timeouts / ETIMEDOUT / ECONNRESET",
        "'suddenly stopped working' across multiple agents at once",
        "slow responses from one provider but not others"
      ],
      "checks": [
        { "name": "anthropic (claude-code) reachable", "agents": ["claude-code"], "kind": "net", "host": "api.anthropic.com", "port": 443, "timeout": 5 },
        { "name": "openai-compatible endpoint reachable", "agents": ["codex", "opencode", "pi", "aider"], "kind": "net", "host": "api.openai.com", "port": 443, "timeout": 5 },
        { "name": "kimi (kimi-code) reachable", "agents": ["kimi-code"], "kind": "net", "host": "api.moonshot.ai", "port": 443, "timeout": 5 },
        { "name": "google (gemini) reachable", "agents": ["gemini"], "kind": "net", "host": "generativelanguage.googleapis.com", "port": 443, "timeout": 5 },
        { "name": "zhipu (zcode/glm) reachable", "agents": ["zcode"], "kind": "net", "host": "open.bigmodel.cn", "port": 443, "timeout": 5 },
        { "name": "alibaba (qwen) reachable", "agents": ["qwen-code"], "kind": "net", "host": "dashscope.aliyuncs.com", "port": 443, "timeout": 5 }
      ],
      "fixes": [
        {
          "name": "Manual: fix network layer (see fixes/net-connectivity.md)",
          "manual": true,
          "cmd": "echo 'Manual steps: check proxy env / DNS / VPN / hosts file; use a mirror (npm-registry-mirror); retry after network change. Full guide: fixes/net-connectivity.md'"
        }
      ],
      "verify": [
        { "name": "anthropic (claude-code) reachable", "agents": ["claude-code"], "kind": "net", "host": "api.anthropic.com", "port": 443, "timeout": 5 },
        { "name": "openai-compatible endpoint reachable", "agents": ["codex", "opencode", "pi", "aider"], "kind": "net", "host": "api.openai.com", "port": 443, "timeout": 5 },
        { "name": "kimi (kimi-code) reachable", "agents": ["kimi-code"], "kind": "net", "host": "api.moonshot.ai", "port": 443, "timeout": 5 },
        { "name": "google (gemini) reachable", "agents": ["gemini"], "kind": "net", "host": "generativelanguage.googleapis.com", "port": 443, "timeout": 5 },
        { "name": "zhipu (zcode/glm) reachable", "agents": ["zcode"], "kind": "net", "host": "open.bigmodel.cn", "port": 443, "timeout": 5 },
        { "name": "alibaba (qwen) reachable", "agents": ["qwen-code"], "kind": "net", "host": "dashscope.aliyuncs.com", "port": 443, "timeout": 5 }
      ],
      "doc": "fixes/net-connectivity.md"
    },
    {
      "id": "opencode-mcp-schema",
      "title": "opencode.json mcp entry uses invalid schema (type stdio) -> ConfigInvalidError",
      "agents": ["opencode"],
      "symptoms": [
        "every opencode command (incl. session list / -c history) fails with 'Error: ConfigInvalidError'",
        "opencode.json mcp.<name> uses \"type\": \"stdio\" or string command (must be local with ARRAY command, or remote; enabled required)"
      ],
      "checks": [
        {
          "name": "opencode session list validates config",
          "cmd": "opencode session list 2>&1",
          "pass": { "stdout_not_contains": ["ConfigInvalidError", "Configuration is invalid"] }
        },
        {
          "name": "no stdio-type entries in opencode.json mcp block",
          "cmd": "node -e \"const fs=require('fs'),os=require('os'),path=require('path');const p=path.join(os.homedir(),'.config','opencode','opencode.json');if(!fs.existsSync(p))process.exit(2);const s=fs.readFileSync(p,'utf8');if(/\\\"type\\\"\\s*:\\s*\\\"stdio\\\"/.test(s)){console.error('BAD');process.exit(1)}console.log('OK')\"",
          "pass": { "stdout_contains": ["OK"] }
        }
      ],
      "fixes": [
        {
          "name": "Rewrite invalid mcp entries to local/remote schema (see doc)",
          "manual": true,
          "cmd": "echo 'Manual/edit step: see fixes/opencode-mcp-schema.md — each mcp.<name> must be type=local with command ARRAY + enabled, or type=remote with url + enabled. Re-run python scripts/fix.py mcp register opencode after fixing.'"
        }
      ],
      "verify": [
        { "name": "opencode session list", "cmd": "opencode session list 2>&1" },
        { "name": "opencode smoke run", "cmd": "opencode run 'Respond with exactly: OK' 2>&1" }
      ],
      "doc": "fixes/opencode-mcp-schema.md"
    },
    {
      "id": "deepseek-harness-broken",
      "title": "DeepSeek Harness (dsh) broken — binary missing / engine too old / install incomplete",
      "agents": ["dsh"],
      "symptoms": [
        "dsh --version fails with 'not recognized' / 'command not found' / 'Cannot find module'",
        "dsh web or dsh --profile ... fails to boot with EBADENGINE or a missing plugin bundle",
        "after `npm i -g @deepseek-ai/dsh` the dsh command does not appear on PATH"
      ],
      "checks": [
        {
          "name": "dsh binary runs",
          "cmd": "dsh --version 2>&1",
          "pass": { "stdout_not_contains": ["not recognized", "command not found", "cannot find module", "internal/modules/cjs/loader", "node:internal"] }
        },
        {
          "name": "node engine ok (major >= 20)",
          "cmd": "node -e \"const m=Number(process.versions.node.split('.')[0]);process.exit(m>=20?0:1)\"",
          "pass": { "exit": 0 }
        },
        {
          "name": "@deepseek-ai/dsh package installed (global)",
          "cmd": "node -e \"const{execSync}=require('child_process');const root=execSync('npm root -g').toString().trim();const p=root+'/@deepseek-ai/dsh/package.json';require('fs').accessSync(p);console.log('FOUND '+p)\" 2>&1",
          "pass": { "stdout_contains": ["FOUND"] }
        },
        {
          "name": "dsh web help (bundle boot smoke)",
          "cmd": "dsh web --help 2>&1",
          "pass": { "exit": 0 }
        }
      ],
      "fixes": [
        {
          "name": "Reinstall @deepseek-ai/dsh globally (manual, see doc)",
          "manual": true,
          "cmd": "echo 'Manual step: npm install -g @deepseek-ai/dsh (rebuilds bundles + deps). See fixes/deepseek-harness.md'"
        },
        {
          "name": "Node too old — install Node LTS (manual, see doc)",
          "manual": true,
          "cmd": "echo 'Manual step: install Node LTS (nvm install lts && nvm use lts), then reinstall @deepseek-ai/dsh. See fixes/deepseek-harness.md'"
        }
      ],
      "verify": [
        { "name": "dsh --version", "cmd": "dsh --version 2>&1" },
        { "name": "dsh --help (boot smoke)", "cmd": "dsh --help 2>&1" },
        { "name": "dsh web --help (web bundle smoke)", "cmd": "dsh web --help 2>&1" }
      ],
      "doc": "fixes/deepseek-harness.md"
    }
  ]
}
