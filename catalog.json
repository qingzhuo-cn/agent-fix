{
  "name": "agent-fix",
  "version": "2.0.0",
  "description": "Universal diagnostic/fix catalog for ALL AI coding agents (Claude Code, Codex, OpenCode, Hermes, Kimi Code, MiniMax Code, Pi, ZCode, Cursor, ...) — plus MCP server, branch skills, any-provider config, and network diagnostics",
  "agents": {
    "claude-code":  { "name": "Claude Code",          "bin": ["claude"],            "config": "~/.claude",             "skills": "~/.claude/skills",        "npm_pkg": "@anthropic-ai/claude-code", "provider_env": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"], "hook": "claude",   "mcp": "claude",   "home": "https://docs.anthropic.com/claude-code" },
    "codex":        { "name": "Codex CLI",             "bin": ["codex"],             "config": "~/.codex",              "skills": "~/.codex/skills",          "npm_pkg": "@openai/codex",            "provider_env": ["OPENAI_API_KEY"], "hook": "codex",    "mcp": "codex",    "home": "https://github.com/openai/codex" },
    "opencode":     { "name": "OpenCode",              "bin": ["opencode"],          "config": "~/.config/opencode",    "skills": "~/.config/opencode/skills",  "npm_pkg": "opencode-ai",              "provider_env": ["OPENAI_API_KEY"], "hook": "opencode", "mcp": "opencode", "home": "https://opencode.ai" },
    "hermes":       { "name": "Hermes Agent",          "bin": ["hermes"],            "config": { "posix": "~/.local/share/hermes", "win": "$LOCALAPPDATA/hermes" }, "skills": { "posix": "~/.local/share/hermes/skills", "win": "$LOCALAPPDATA/hermes/skills" }, "npm_pkg": null, "provider_env": [], "hook": "hermes", "home": "https://hermes-agent.nousresearch.com" },
    "kimi-code":    { "name": "Kimi Code",             "bin": ["kimi"],              "config": "~/.kimi-code",          "config_env": "KIMI_CODE_HOME", "skills": "~/.kimi-code/skills", "skills_env": "KIMI_CODE_HOME", "npm_pkg": "@moonshot-ai/kimi-code",   "provider_env": [], "mcp": "kimi-code", "node_requirement": ">=22.19.0", "home": "https://kimi.com/code" },
    "minimax-code": { "name": "MiniMax Code",          "bin": ["mcode"],             "config": "~/.minimax",             "config_env": ["MINIMAX_DATA_DIR", "MAVIS_DATA_DIR"], "skills": "~/.minimax/skills", "skills_env": ["MINIMAX_DATA_DIR", "MAVIS_DATA_DIR"], "npm_pkg": "@minimax-ai/code",         "provider_env": ["MCODE_PROVIDER_API_KEY"], "mcp": "minimax-code", "node_requirement": ">=22.19.0 <23.0.0 || >=24.0.0 <27.0.0", "home": "https://agent.minimax.cn/docs/cli/quick-start" },
    "pi":           { "name": "Pi (pi-coding-agent)",  "bin": ["pi"],                "config": "~/.pi",                 "skills": "~/.pi/agent/skills",       "npm_pkg": "@earendil-works/pi-coding-agent", "provider_env": ["OPENAI_API_KEY", "ANTHROPIC_API_KEY"], "home": "https://pi.dev" },
    "zcode":        { "name": "ZCode",                 "bin": ["zcode"],             "config": "~/.zcode",              "skills": "~/.agents/skills",         "npm_pkg": null,                       "provider_env": [], "no_version": true, "home": "https://zcode.ai" },
    "cursor":       { "name": "Cursor",                "bin": ["cursor"],            "config": "~/.cursor",             "skills": "~/.cursor/skills",         "npm_pkg": null,                       "provider_env": [], "no_version": true, "mcp": "cursor", "home": "https://cursor.com" },
    "gemini":       { "name": "Gemini CLI",            "bin": ["gemini"],            "config": "~/.gemini",             "skills": null,                      "npm_pkg": "@google/gemini-cli",       "provider_env": ["GEMINI_API_KEY"], "home": "https://github.com/google-gemini/gemini-cli" },
    "aider":        { "name": "Aider",                 "bin": ["aider"],             "config": "~/.config/aider",       "skills": null,                      "npm_pkg": null,                       "provider_env": ["OPENAI_API_KEY"], "home": "https://aider.chat" },
    "qwen-code":    { "name": "Qwen Code",             "bin": ["qwen-code"],         "config": "~/.qwen-code",          "skills": null,                      "npm_pkg": "@qwen-code/qwen-code",     "provider_env": ["DASHSCOPE_API_KEY"], "home": "https://qwen.ai" },
    "amp":          { "name": "Amp",                   "bin": ["amp"],               "config": "~/.config/amp",         "skills": "~/.config/amp/tools",      "npm_pkg": null,                       "provider_env": [], "home": "https://amp.dev" },
    "droid":        { "name": "Droid",                 "bin": ["droid"],             "config": "~/.factory",            "skills": "~/.factory/skills",        "npm_pkg": null,                       "provider_env": [], "home": "https://getdroid.ai" },
    "dsh":          { "name": "DeepSeek Harness",      "bin": ["dsh"],               "config": null,                    "skills": null,                       "npm_pkg": "@deepseek-ai/dsh",         "provider_env": [], "command_only": true, "home": "https://github.com/deepseek-ai/DeepSeek-Harness" }
  },
  "issues": [
    {
      "id": "npm-postinstall-skipped",
      "title": "npm postinstall skipped -> native binary missing",
      "agents": ["claude-code", "codex", "opencode", "pi", "gemini", "qwen-code", "kimi-code", "minimax-code"],
      "symptoms": [
        "{name} --version fails with 'postinstall script was not run' / 'native binary not installed'",
        "GUI tools show the agent as 'installed but cannot run'"
      ],
      "checks": [
        {
          "name": "npm ignore-scripts must be false",
          "cmd": "npm config get ignore-scripts",
          "pass": { "stdout_equals": "false" }
        },
        {
          "name": "{name} binary runs (npm-postinstall)",
          "cmd": "{bin} --version 2>&1",
          "pass": { "stdout_not_contains": ["postinstall", "native binary", "not installed", "Error", "command not found", "not recognized"] }
        }
      ],
      "fixes": [
        {
          "name": "Re-run {name} install/postinstall script",
          "cwd": "npm_root/{npm_pkg}",
          "cmd": "node -e \"const s=require('./package.json').scripts||{};const f=s.postinstall||s.install;if(!f){console.error('no install/postinstall script');process.exit(1)}console.log('running:',f);require('child_process').execSync(f,{stdio:'inherit'})\""
        }
      ],
      "verify": [
        { "name": "{name} --version", "cmd": "{bin} --version 2>&1" }
      ],
      "doc": "fixes/npm-postinstall.md"
    },
    {
      "id": "gui-path-blind",
      "title": "GUI apps (CC-Switch etc.) cannot see agent binaries",
      "agents": ["claude-code", "codex", "opencode", "hermes"],
      "symptoms": [
        "CC-Switch or other GUI reports 'installed - cannot run'",
        "command works in terminal but not in GUI-launched processes"
      ],
      "checks": [
        {
          "name": "npm global dir in GUI PATH",
          "agents": ["claude-code", "codex", "opencode"],
          "platform": "windows",
          "cmd": "powershell -NoProfile -Command \"\\$d=[Environment]::GetEnvironmentVariable('Path','User')+';'+[Environment]::GetEnvironmentVariable('Path','Machine');if(\\$d -match 'npm'){Write-Output 'FOUND'}else{Write-Output 'MISSING'}\"",
          "pass": { "stdout_contains": ["FOUND"] }
        },
        {
          "name": "hermes bin dir in GUI PATH",
          "agents": ["hermes"],
          "platform": "windows",
          "cmd": "powershell -NoProfile -Command \"\\$d=[Environment]::GetEnvironmentVariable('Path','User')+';'+[Environment]::GetEnvironmentVariable('Path','Machine');if(\\$d -match 'hermes'){Write-Output 'FOUND'}else{Write-Output 'MISSING'}\"",
          "pass": { "stdout_contains": ["FOUND"] }
        }
      ],
      "fixes": [
        {
          "name": "Add npm global dir to user PATH (registry)",
          "agents": ["claude-code", "codex", "opencode"],
          "platform": "windows",
          "cmd": "powershell -NoProfile -Command \"\\$d=[Environment]::GetEnvironmentVariable('Path','User');\\$p=(npm config get prefix);if(\\$d -notmatch [regex]::Escape(\\$p)){[Environment]::SetEnvironmentVariable('Path',\\$d+';'+\\$p,'User');Write-Output ('Added: '+\\$p)}else{Write-Output 'npm dir already in user PATH'}\""
        },
        {
          "name": "Add hermes bin dir to user PATH (registry)",
          "agents": ["hermes"],
          "platform": "windows",
          "cmd": "powershell -NoProfile -Command \"\\$d=[Environment]::GetEnvironmentVariable('Path','User');\\$p=(Split-Path (Get-Command hermes -ErrorAction SilentlyContinue).Source -Parent);if(\\$p -and \\$d -notmatch [regex]::Escape(\\$p)){[Environment]::SetEnvironmentVariable('Path',\\$d+';'+\\$p,'User');Write-Output ('Added: '+\\$p)}else{Write-Output 'hermes dir already in user PATH or hermes not found'}\""
        }
      ],
      "verify": [
        {
          "name": "npm dir visible to GUI PATH",
          "agents": ["claude-code", "codex", "opencode"],
          "platform": "windows",
          "cmd": "powershell -NoProfile -Command \"\\$d=[Environment]::GetEnvironmentVariable('Path','User')+';'+[Environment]::GetEnvironmentVariable('Path','Machine');if(\\$d -match 'npm'){Write-Output 'OK'}else{Write-Output 'STILL-MISSING'}\""
        },
        {
          "name": "hermes dir visible to GUI PATH",
          "agents": ["hermes"],
          "platform": "windows",
          "cmd": "powershell -NoProfile -Command \"\\$d=[Environment]::GetEnvironmentVariable('Path','User')+';'+[Environment]::GetEnvironmentVariable('Path','Machine');if(\\$d -match 'hermes'){Write-Output 'OK'}else{Write-Output 'STILL-MISSING'}\""
        }
      ],
      "doc": "fixes/gui-path.md"
    },
    {
      "id": "node-version-too-old",
      "title": "Node too old for the agent",
      "agents": ["claude-code", "codex", "opencode", "pi", "gemini", "qwen-code", "kimi-code", "minimax-code"],
      "symptoms": [
        "EBADENGINE / 'Unsupported engine' during npm install",
        "agent crashes at startup with a SyntaxError or engines message"
      ],
      "checks": [
        {
          "name": "node is installed",
          "cmd": "node -v 2>&1",
          "pass": { "stdout_not_contains": ["not recognized", "command not found"] }
        },
        {
          "name": "node satisfies the agent engine requirement",
          "kind": "node_requirement"
        }
      ],
      "fixes": [
        {
          "name": "Install Node LTS via nvm-windows/fnm (manual, see doc)",
          "manual": true,
          "cmd": "echo 'Manual step: install Node LTS (nvm install lts && nvm use lts on Windows; nvm install --lts on POSIX), then reinstall global agents. See fixes/node-version.md'"
        }
      ],
      "verify": [
        { "name": "node satisfies the agent engine requirement", "kind": "node_requirement" }
      ],
      "doc": "fixes/node-version.md"
    },
    {
      "id": "npm-registry-mirror",
      "title": "npm registry slow or unreachable",
      "agents": ["claude-code", "codex", "opencode", "pi", "gemini", "qwen-code", "kimi-code", "minimax-code"],
      "symptoms": [
        "npm install/upgrade hangs or fails with ETIMEDOUT/ECONNRESET",
        "agent upgrades fail mid-way and leave postinstall skipped"
      ],
      "checks": [
        {
          "name": "npm registry reachable",
          "cmd": "npm ping 2>&1",
          "timeout": 45,
          "pass": { "stdout_contains": ["PONG"] }
        }
      ],
      "fixes": [
        {
          "name": "Switch registry to npmmirror (China-friendly)",
          "cmd": "npm config set registry https://registry.npmmirror.com"
        }
      ],
      "verify": [
        { "name": "npm config get registry", "cmd": "npm config get registry 2>&1" },
        { "name": "npm ping", "cmd": "npm ping 2>&1", "timeout": 45 }
      ],
      "doc": "fixes/npm-registry.md"
    },
    {
      "id": "agent-auth-broken",
      "title": "Agent not logged in / expired auth / missing API key",
      "agents": ["all"],
      "symptoms": [
        "'Not logged in' or 401 Unauthorized on every prompt",
        "--version works but real prompts fail"
      ],
      "checks": [
        {
          "name": "{name}: credential file or auth env present",
          "kind": "env_keys",

          "pass": { "stdout_contains_any": ["KEY-SET", "CONFIG-OK"] }
        }
      ],
      "fixes": [
        {
          "name": "Interactive login for {name} (manual, see doc)",
          "manual": true,
          "cmd": "echo 'Manual step: log in to {name} (or set the provider key/base URL per fixes/agent-auth.md)'"
        }
      ],
      "verify": [

      ],
      "doc": "fixes/agent-auth.md"
    },
    {
      "id": "provider-config",
      "title": "Agent provider not configured (no API key / base URL / model)",
      "agents": ["all"],
      "symptoms": [
        "agent starts but every prompt fails with 401 / 'model not found' / 'no provider'",
        "user wants to switch an agent to ANY provider (DeepSeek, OpenAI, Anthropic, Google, Moonshot, Zhipu, Qwen, Ollama, OpenRouter, custom)",
        "provider switcher (CC-Switch) left the agent with no valid credential"
      ],
      "checks": [
        {
          "name": "{name}: provider configured (key env or config home)",
          "kind": "env_keys",

          "pass": { "stdout_contains_any": ["KEY-SET", "CONFIG-OK"] }
        }
      ],
      "fixes": [
        {
          "name": "Configure a provider for {name} (manual — any provider, see fixes/provider-config.md)",
          "manual": true,
          "cmd": "echo 'Manual step: set the provider key/base URL/model per fixes/provider-config.md, or use the MCP provider tool for auto-generated snippets'"
        }
      ],
      "verify": [

      ],
      "doc": "fixes/provider-config.md"
    },
    {
      "id": "agent-broken-generic",
      "title": "Any installed agent binary fails to run (postinstall / native binary / missing)",
      "agents": ["all"],
      "symptoms": [
        "any AI coding agent reports errors on --version after install/upgrade",
        "GUI tools show any agent as 'installed but cannot run'"
      ],
      "checks": [
        {
          "name": "{name} binary runs",
          "cmd": "{bin} --version 2>&1",
          "pass": {
            "stdout_not_contains": [
              "postinstall script was not run",
              "postinstall script has not been run",
              "native binary not",
              "native binary missing",
              "not recognized",
              "command not found",
              "cannot run",
              "internal/modules/cjs/loader",
              "Cannot find module"
            ]
          }
        }
      ],
      "fixes": [
        {
          "name": "Route {name} to the matching repair path",
          "manual": true,
          "cmd": "echo 'Manual step: for an npm-distributed {name}, run fix apply npm-postinstall-skipped with the same --agent id; for native/desktop agents consult fixes/agent-matrix.md'"
        }
      ],
      "verify": [
        { "name": "{name} --version", "cmd": "{bin} --version 2>&1" }
      ],
      "doc": "fixes/agent-matrix.md"
    },
    {
